# Endereço do backend (FastAPI). Em produção, o endereço público do seu backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Modo de demonstração: deixe desligado (0). O npm run demo liga sozinho (1),
# aponta as chamadas para a API de exemplo (demo/api-demo.mjs) e entra sem senha.
NEXT_PUBLIC_DEMO=0
# Endereço da API de exemplo, usado só com NEXT_PUBLIC_DEMO=1.
# NEXT_PUBLIC_DEMO_API_URL=http://127.0.0.1:8710
