# Personal Brand Studio: variáveis de ambiente (valores de exemplo)
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA comite o arquivo .env no Git.

# ── Banco de Dados ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:sua_senha@localhost:5432/personal_brand_os

# ── Segurança ────────────────────────────────────────────────────────────────
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=sua_chave_fernet_aqui

# Gere com: openssl rand -hex 32
SECRET_KEY=seu_secret_key_aqui

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=seu_client_id
LINKEDIN_CLIENT_SECRET=seu_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/oauth/linkedin/callback

# ── Instagram / Meta OAuth ────────────────────────────────────────────────────
INSTAGRAM_APP_ID=seu_app_id
INSTAGRAM_APP_SECRET=seu_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/oauth/instagram/callback

# ── App Config ────────────────────────────────────────────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# Seed (só para rodar scripts/seed_user.py localmente)
SEED_USER_PASSWORD=

# Armazenamento de mídia (bucket S3: Railway Storage Bucket ou Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ADDRESSING_STYLE=virtual
MEDIA_URL_TTL_SECONDS=21600

# ── Facebook (Página) ─────────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/oauth/facebook/callback
# A única Página em que o app publica (o ID aparece em Sobre > Transparência da Página)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_NAME=

# ── IA (Anthropic) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Texto da persona usado pela IA (sem ele, vale config/persona.example.txt)
PERSONA_FILE=config/persona.txt

# ── Acesso ao app e Calendário ────────────────────────────────────────────────
# Senha única de acesso ao app (Bearer). Gere com: openssl rand -hex 24
APP_ACCESS_TOKEN=
# Chave do envio do espelho do Calendário (scripts/enviar_espelho_calendario.py)
CALENDARIO_SYNC_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Endereços extras do frontend, separados por vírgula
CORS_EXTRA_ORIGINS=
# Expressão regular opcional para deploy previews, ex.: ^https://deploy-preview-\d+--seu-site\.netlify\.app$
CORS_ORIGIN_REGEX=

# Seed (só para rodar scripts/seed_user.py localmente)
SEED_USER_NAME=
SEED_USER_EMAIL=
